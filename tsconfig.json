{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noImplicitAny": true,
        "incremental": true,
        "resolveJsonModule": true,
        "typeRoots": [
            "./node_modules/@types",
            "./types"
        ]
    },
    // Build output contains copies of TypeScript sources (e.g. copied
    // _locales/*.ts) whose relative imports only resolve from src/;
    // exclude it so tsc never type-checks generated files. node_modules
    // is listed explicitly because setting "exclude" replaces the
    // default exclusion list.
    "exclude": [
        "node_modules",
        "build"
    ],
    // Scripts execute through ts-node, which runs them as CommonJS;
    // keep its module settings on the pre-modernization values while
    // tsc and ESLint use the bundler-style configuration above.
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs",
            "moduleResolution": "node"
        }
    }
}
